# Voter — environment variables
# Copy to .env.local and fill in. .env.local is gitignored.

# ============================================================
# Required for the app to run
# ============================================================

# Supabase (anon key — used by client + server for RLS-protected reads)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Canonical site URL for metadata (OG tags, sitemap links). Optional —
# falls back to https://ballotmatch.org (src/app/layout.tsx) when unset.
NEXT_PUBLIC_SITE_URL=

# Privacy-preserving identifier hashing — server-side HMAC key.
# 32+ random bytes. Used to hash IPs and user-agent strings for the
# consent_audit and session_visits tables. Without this, a leaked
# database would let attackers brute-force IP hashes (2^32 IPv4 keyspace
# computes in minutes on commodity GPUs).
# Generate: `openssl rand -hex 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
# Rotate: monthly. Never log. Never return in responses.
# Required in production. Dev falls back to a fixed dev-only string with a console warning.
IP_HASH_SECRET=

# ============================================================
# LLM matching (Phase 2B)
# ============================================================

# Anthropic — used for both the live /api/match path and offline stance synthesis.
# Cheapest tier (Haiku 4.5) is sufficient for both.
# Without this, /api/match falls back to a deterministic local heuristic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Kill switch for the LLM matcher. Set to "true" to disable Haiku calls
# (e.g., during a runaway-cost incident). Mock fallback still serves matches.
MATCH_API_DISABLED=

# ============================================================
# Rate limiting (optional — Upstash Redis)
# ============================================================

# Distributed rate-limit store for /api/match and the engagement-write
# APIs (see src/lib/rate-limit.ts). Auto-populated by the Upstash Redis
# add-on from the Vercel Marketplace. Without these, the limiter falls
# back to in-memory (fine for dev and CI, not distributed in prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Data pipeline scripts (scripts/ingest/* and scripts/seed/*)
# Not used by the app at runtime. Only needed when curating new races.
# ============================================================

# Donor industries: classified downstream by Haiku from FEC's itemized
# contributions (see scripts/ingest/classify_industries.ts). OpenSecrets and
# FollowTheMoney both retired their public APIs — no env var needed.

# Voting records: see the "Voting records (T10)" section below
# (Congress.gov + Voteview). The old GovTrack client was removed.

# FEC.gov — raw filings, fundraising totals (source of truth).
# https://api.data.gov/signup/
FEC_API_KEY=

# NewsAPI.org — public statements ingester (npm run ingest:news).
# Free tier: 100 req/day, 1-month rolling archive. Sign up at
# https://newsapi.org/register. Skipped silently when unset; the rest
# of the pipeline still completes.
NEWSAPI_KEY=

# Supabase service role — used ONLY by seed scripts. Bypasses RLS.
# DO NOT commit, DO NOT expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (HTTP Basic). Set in Vercel for production.
# Generate: openssl rand -hex 24
ADMIN_PASSWORD=

# ============================================================
# Voting records (T10, 2026-08-06 rework)
# ============================================================

# Congress.gov official API — House roll-call votes, bioguide-keyed.
# https://api.congress.gov/sign-up/ (free, 5,000 req/hr).
# Required by src/lib/api-clients/congress-gov.ts and
# scripts/ingest/fetch_votes.ts (--chamber house). Every function that
# calls the API throws a clear error naming this var when it's unset —
# there is no silent empty-result fallback.
CONGRESS_GOV_API_KEY=

# Senate roll-call votes: Voteview (https://voteview.com/data), public CSV
# exports. No key needed — src/lib/api-clients/voteview.ts.

# ID crosswalk (House + Senate, incumbent bioguide <-> fec_candidate_id):
# unitedstates/congress-legislators, fetched from GitHub raw. No key
# needed — src/lib/api-clients/legislators.ts.
